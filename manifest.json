{
  "manifest_version": 3,
  "name": "Komiko Grab-n-Go",
  "version": "1.0.4",
  "author": "softbellypig",
  "description": "Scan your Komiko generations and save every image to a dated folder. Scroll to the bottom, click Scan, click Download, go have a snack.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://komiko.app/*",
    "*://*.komiko.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
